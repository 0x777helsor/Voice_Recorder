        management.</string>

    <!-- Legal / privacy -->
    <string name="legal_title">Legal and privacy</string>
    <string name="legal_recording_law">Recording laws vary by jurisdiction. You are responsible for
        understanding and complying with the laws that apply where you are. SafeSignal does not
        make recording lawful.</string>
    <string name="legal_admissibility">SafeSignal uses integrity-preserving storage and export
        mechanisms. Legal admissibility and evidentiary weight depend on the applicable
        jurisdiction, the circumstances, authenticity requirements and the relevant authority or
        court. Consult a qualified legal professional where appropriate.</string>
    <string name="privacy_listening">SafeSignal listens locally for your activation phrase while
        Emergency Listening is enabled. Audio is not permanently recorded until activation.</string>
    <string name="privacy_recording">When activated, SafeSignal records using the device
        microphone.</string>
    <string name="privacy_sync">Recordings remain on the device unless synchronisation is
        enabled.</string>
    <string name="privacy_enhancement">Enhanced audio is a derivative copy. The original recording
        is preserved.</string>
    <string name="privacy_transcription">Transcripts are machine-generated and do not replace the
        original audio.</string>
    <string name="privacy_microphone_limits">Phone microphones have physical limits. Distance,
        walls, wind, handling, orientation, obstruction, competing sounds, room acoustics and
        speaker volume can all affect whether speech is intelligible. No application can recover
        speech that never reached the microphone.</string>

