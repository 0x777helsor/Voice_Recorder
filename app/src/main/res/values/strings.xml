<?xml version="1.0" encoding="utf-8"?>
<!--
    All user-facing text lives here so it can be localised and reviewed as copy
    rather than scattered through Kotlin.

    Copy rules (SPEC §98): never claim guaranteed admissibility, never claim
    capture beyond the microphone's physical reach, and never imply that SafeSignal
    cannot be detected or stopped.
-->
<resources>
    <string name="app_name">SafeSignal</string>

    <!-- Onboarding / consent -->
    <string name="onboarding_title">SafeSignal</string>
    <string name="onboarding_body">SafeSignal helps you preserve emergency audio when you cannot
        safely operate your phone. It works locally first, depends on the physical microphone of
        your device, preserves the original recording, and synchronises encrypted evidence only
        when you have enabled it.</string>
    <string name="onboarding_microphone_heading">Emergency Listening</string>
    <string name="onboarding_microphone_body">Your phone will listen locally for your activation
        phrase.\n\nWhen activation is detected:\n• recording will begin;\n• the recording will be
        encrypted locally;\n• synchronisation will occur only if enabled;\n• Android will show the
        required microphone and foreground-service indicators;\n• battery usage may increase.\n\nUse
        only where lawful.</string>
    <string name="onboarding_permission_rationale">SafeSignal needs the microphone to listen for your
        activation phrase and to record after activation. Recording only ever happens after you have
        armed Emergency Listening, and Android shows its own microphone indicator while it
        does.</string>
    <string name="onboarding_continue">Continue</string>
    <string name="onboarding_grant_microphone">Allow microphone</string>
    <string name="onboarding_grant_notifications">Allow notifications</string>

