{
  "name": "safesignal-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "SafeSignal reference backend: encrypted-evidence synchronisation. Stores ciphertext only.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/server.js",
    "dev": "tsc -p tsconfig.build.json && node dist/src/server.js",
    "pretest": "tsc -p tsconfig.json",
    "test": "node --test \"dist/test/*.test.js\"",
    "migrate": "tsc -p tsconfig.build.json && node dist/scripts/migrate.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.699.0",
    "@aws-sdk/s3-request-presigner": "^3.699.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^12.0.1",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.2"
  }
}
