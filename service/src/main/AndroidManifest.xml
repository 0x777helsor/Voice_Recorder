<?xml version="1.0" encoding="utf-8"?>
<!--
    The emergency audio service is declared here rather than in :app, so that the
    component and the code that implements it live in the same module and cannot
    drift apart. This fragment is merged into the application manifest.

    `foregroundServiceType="microphone"` is mandatory on API 34+: without it the
    platform refuses to start a microphone foreground service, and with the wrong
    type it throws `SecurityException`. It is also an accurate statement of what
    the service does, which is the point — Android requires the type precisely so
    that holding the microphone is always an explicit, declared act.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <service
            android:name=".EmergencyAudioService"
            android:exported="false"
            android:foregroundServiceType="microphone"
            android:stopWithTask="false" />

        <!--
            Receives media-button events while the app is backgrounded.

            This is the mechanism behind the volume-pattern trigger, and it has to be
            declared here or the PendingIntent the media session publishes is never
            delivered — the app would appear armed and the trigger could never fire.

            `exported="true"` is required because the *system* delivers the broadcast,
            and the platform refuses to deliver to an unexported receiver. It is safe
            because the receiver does nothing on its own: it forwards the key event to
            the in-process matcher, and the pattern must match before anything happens.
            There is no way to start a recording by sending this broadcast directly.
        -->
        <receiver
            android:name=".trigger.VolumeKeyReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
