<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification and service copy.

    This copy lives with the service rather than in :app because the module that
    renders it is the module that owns it, and a library cannot read the
    application module's resources. The app module reads these through the merged
    resource table, so there is still exactly one definition of each string.

    Copy rules (SPEC §98): never claim guaranteed admissibility, never imply the
    recording cannot be detected or stopped, and never suggest SafeSignal can
    capture beyond the microphone's physical reach.
-->
<resources>

    <string name="safesignal_notification_channel_recording">Emergency Recording</string>
    <string name="safesignal_notification_channel_recording_description">Shown while SafeSignal is
        recording. The microphone is in use for the whole time this notification is visible.</string>
    <string name="safesignal_notification_channel_listening">Emergency Listening</string>
    <string name="safesignal_notification_channel_listening_description">Shown while SafeSignal is
        armed and listening locally for your activation phrase.</string>

    <string name="safesignal_notification_recording_title">SafeSignal is recording</string>
    <string name="safesignal_notification_recording_text">Recording and encrypting on this
        device.</string>
    <string name="safesignal_notification_listening_title">SafeSignal is listening</string>
    <string name="safesignal_notification_listening_text">Listening locally for your activation
        phrase.</string>
    <string name="safesignal_notification_action_stop">Stop</string>
    <string name="safesignal_notification_summary_title">SafeSignal test recording</string>

    <!--
        Shown when the service refuses to start because the ongoing notification
        would not be visible. Refusing is deliberate; see EmergencyAudioService.
    -->
    <string name="safesignal_service_notification_blocked">SafeSignal will not record while its
        notification is hidden. Allow notifications for SafeSignal, then try again.</string>

    <!--
        Shown when the microphone could not be opened at all.

        Deliberately says what is still true rather than what went wrong: the user
        needs to know whether anything is at risk, and an error string that leads
        with a technical cause is not that.
    -->
    <string name="safesignal_service_start_failed">Could not start recording. Nothing was
        captured, and nothing was lost.</string>

    <!--
        The test finished and produced audio.

        Written for someone who has just been told an app recorded them. It states
        how long they were recorded for, how much was kept, and — most importantly —
        that the file is scrambled, so that "the audio is encrypted" is understood as
        "it cannot be played or read by anyone, including this app's server", rather
        than left as jargon.

        "You were recorded" is not softened. The user is entitled to the plain fact.
    -->
    <string name="safesignal_test_complete">Test finished. You were recorded for %1$s and
        %2$s of audio was saved. The microphone has been released. The recording is
        scrambled, so it cannot be played or listened to by anyone, including
        SafeSignal\'s server.</string>

    <string name="safesignal_test_no_audio">The test finished but captured no audio. Nothing
        was saved. Check that nothing else — a call, a voice recorder, another app —
        was using the microphone.</string>
    <string name="safesignal_test_failed">The test stopped early: %1$s. Any audio already
        captured is still saved on this device.</string>

</resources>
